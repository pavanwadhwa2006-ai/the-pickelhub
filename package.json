{
  "name": "picklehub",
  "version": "1.0.0",
  "description": "The PickleHub — Competitive Pickleball Sports-Tech Platform",
  "private": true,
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "npm --prefix server run dev",
    "dev:client": "npm --prefix client run dev",
    "build": "npm --prefix client run build",
    "test": "npm --prefix server test",
    "lint": "npm --prefix server run lint && npm --prefix client run lint && npm run ci:guardrails",
    "ci:guardrails": "node scripts/ci-guardrails.js",
    "make-admin": "node scripts/promote-admin.js",
    "seed": "node scripts/seed.js"
  },
  "dependencies": {
    "@vercel/blob": "^2.8.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "google-auth-library": "^11.0.2",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^8.14.1",
    "morgan": "^1.10.0",
    "multer": "^2.2.0"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
