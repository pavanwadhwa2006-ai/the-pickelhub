# ============================================
# The PickleHub — Environment Variables
# ============================================
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.
# ============================================

# MongoDB Atlas Connection
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/picklehub?retryWrites=true&w=majority

# JWT Authentication
JWT_SECRET=your-jwt-secret-here-change-in-production
JWT_EXPIRES_IN=7d

# Refresh Token (httpOnly cookie-based)
REFRESH_TOKEN_SECRET=your-refresh-token-secret-here-change-in-production
ACCESS_TOKEN_EXPIRY=15m
REFRESH_TOKEN_EXPIRY=7d

# Server
PORT=5000
NODE_ENV=development

# Rating Engine (Elo)
# K-factor controls rating sensitivity — higher = bigger swings per match
DEFAULT_K_FACTOR=32

# Client URL (for CORS)
CLIENT_URL=http://localhost:5173

# Google OAuth (Optional — for 1-click Sign in with Google)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

